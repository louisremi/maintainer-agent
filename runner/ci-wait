#!/usr/bin/env bash
# Wait for the CI checks of the pull request whose head is <branch> and report
# the outcome. On failure, print the tail of the failed job logs so the caller
# (usually the agent) can act on it.
#
#   ci-wait <branch> [timeout-seconds]      default timeout: 5400
#
# Checks that wait for a human (the `review-gate` jobs, or anything whose name
# matches CI_WAIT_IGNORE, an extended regex) are ignored: they stay pending
# until a maintainer approves, by design.
#
# Exit codes: 0 all other checks green, 1 at least one failed, 2 no PR / timed
# out / other error. Needs `gh` authenticated for the repository (GH_REPO).
set -euo pipefail

branch="${1:?usage: ci-wait <branch> [timeout-seconds]}"
timeout_s="${2:-5400}"
ignore="${CI_WAIT_IGNORE:-^review-gate( / .*)?$}"

pr="$(gh pr list --head "${branch}" --state open --json number --jq '.[0].number // empty')"
if [[ -z "${pr}" ]]; then
  echo "no open pull request for branch ${branch}" >&2
  exit 2
fi
head_sha="$(gh pr view "${pr}" --json headRefOid --jq .headRefOid)"
echo "waiting for CI on PR #${pr} (${branch} @ ${head_sha:0:12}), timeout ${timeout_s}s"

deadline=$(( $(date +%s) + timeout_s ))
checks() {  # "name<TAB>bucket" for every check that is not ignored
  gh pr checks "${pr}" --json name,bucket --jq '.[] | "\(.name)\t\(.bucket)"' 2>/dev/null \
    | awk -F'\t' -v re="${ignore}" '$1 !~ re'
}

state=""
while :; do
  if (( $(date +%s) >= deadline )); then
    echo "timed out waiting for CI on PR #${pr}" >&2
    printf '%s\n' "${state}" >&2
    exit 2
  fi
  state="$(checks || true)"
  if [[ -z "${state}" ]]; then sleep 15; continue; fi
  if awk -F'\t' '$2 == "fail" || $2 == "cancel" {f=1} END {exit !f}' <<<"${state}"; then break; fi
  if ! awk -F'\t' '$2 == "pending" {f=1} END {exit !f}' <<<"${state}"; then
    printf '%s\n' "${state}"
    echo "CI green for PR #${pr}"
    exit 0
  fi
  sleep 30
done

printf '%s\n' "${state}"
echo
echo "=== failed job logs (tail) ==="
for run_id in $(gh run list --branch "${branch}" --commit "${head_sha}" --limit 20 \
                 --json databaseId,conclusion --jq '.[] | select(.conclusion == "failure") | .databaseId'); do
  echo "--- run ${run_id}"
  gh run view "${run_id}" --log-failed 2>/dev/null | tail -n 300 || true
done
exit 1
